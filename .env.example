# LLM provider: "anthropic", "openai" or "volcano-agent-plan"
LLM_PROVIDER=volcano-agent-plan

# ByteDance Volcano Ark Agent Plan (OpenAI-compatible endpoint)
# Note: Agent Plan uses max_completion_tokens. The requested max_tokens is
# capped to 32768 by the provider, even if you set a higher value.
VOLCANO_AGENT_API_KEY=your_agent_plan_api_key_here
VOLCANO_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VOLCANO_AGENT_MODEL=ark-code-latest

# Fallback OpenAI-compatible configuration (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=doubao-pro-32k

# Anthropic-style configuration (used when LLM_PROVIDER=anthropic)
# Note: Anthropic models currently cap output at 8192 tokens.
# ANTHROPIC_API_KEY=your_anthropic_or_ark_api_key_here
# ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Tavily API Key (required when search backend is "tavily")
TAVILY_API_KEY=your_tavily_api_key_here
